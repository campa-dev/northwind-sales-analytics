/*
===============================================================================
Report: Product Performance Analysis
Project: Northwind Sales Analytics

Business Question:
Which products generate the highest revenue and sales volume across all
historical orders?

Report Grain:
One row per product.

Business Rules:
- Revenue is calculated after discounts.
- Units Sold represents the total quantity sold across all orders.
- Total Orders counts distinct orders containing each product.
- Products are ranked by total historical revenue in descending order.
===============================================================================
*/

WITH product_metrics AS (

    SELECT
        p.product_id,
        p.product_name,
        c.category_name,

        -- Total revenue generated by each product after discounts.
        ROUND(
            SUM((od.unit_price * od.quantity) * (1 - od.discount))::numeric,
            2
        ) AS total_revenue,

        -- Number of unique orders containing the product.
        COUNT(DISTINCT o.order_id) AS total_orders,

        -- Total quantity of units sold across all orders.
        SUM(od.quantity) AS units_sold

    FROM products p

    INNER JOIN categories c
        ON c.category_id = p.category_id

    INNER JOIN order_details od
        ON p.product_id = od.product_id

    INNER JOIN orders o
        ON o.order_id = od.order_id

    GROUP BY
        p.product_id,
        p.product_name,
        c.category_name
)

SELECT
    product_id,
    product_name,
    category_name,
    units_sold,
    total_revenue,
    total_orders,

    -- Rank products by total historical revenue.
    DENSE_RANK() OVER (
        ORDER BY total_revenue DESC
    ) AS revenue_rank

FROM product_metrics

ORDER BY total_revenue DESC;    